// nol.http — briques serveur HTTP en pur Nolc.
//
// Fondation du module : validation de méthode et correspondance de chemin de
// routage. Le serveur complet (parseur HTTP/1.1 + HTTP/2, routeur typé,
// middlewares pré/post, streaming/SSE, fichiers statiques, limites de requêtes,
// arrêt gracieux) s'appuiera sur les primitives réseau de la stdlib Nolc et
// arrive lot par lot — voir README.

// Méthode HTTP reconnue ?
fn methode_valide(m: Text) -> Bool {
    return m == "GET" or m == "POST" or m == "PUT" or m == "DELETE"
        or m == "PATCH" or m == "HEAD" or m == "OPTIONS"
}

// Normalise un chemin : retire une éventuelle barre oblique finale (sauf « / »).
fn chemin_normalise(chemin: Text) -> Text {
    let n = len(chemin)
    if n > 1 and sub(chemin, n - 1, 1) == "/" {
        return sub(chemin, 0, n - 1)
    }
    return chemin
}

// Correspondance exacte de chemin (aux barres finales près). Le routage à
// motifs (« /u/:id ») viendra avec le routeur typé.
fn chemin_correspond(motif: Text, chemin: Text) -> Bool {
    return chemin_normalise(motif) == chemin_normalise(chemin)
}

// Message de statut HTTP pour les codes courants.
fn statut_texte(code: Int) -> Text {
    if code == 200 {
        return "OK"
    }
    if code == 201 {
        return "Created"
    }
    if code == 204 {
        return "No Content"
    }
    if code == 301 {
        return "Moved Permanently"
    }
    if code == 302 {
        return "Found"
    }
    if code == 304 {
        return "Not Modified"
    }
    if code == 400 {
        return "Bad Request"
    }
    if code == 401 {
        return "Unauthorized"
    }
    if code == 403 {
        return "Forbidden"
    }
    if code == 404 {
        return "Not Found"
    }
    if code == 405 {
        return "Method Not Allowed"
    }
    if code == 413 {
        return "Payload Too Large"
    }
    if code == 429 {
        return "Too Many Requests"
    }
    if code == 500 {
        return "Internal Server Error"
    }
    if code == 503 {
        return "Service Unavailable"
    }
    return "Status"
}

// ---- Parsing de la ligne de requête « METHODE CIBLE VERSION » ----

// Méthode d'une ligne de requête (« GET /x HTTP/1.1 » -> « GET »). "" si vide.
fn requete_methode(ligne: Text) -> Text {
    let parts = split(ligne, " ")
    if len(parts) < 1 {
        return ""
    }
    return get(parts, 0)
}

// Cible d'une ligne de requête (« /x?y=1 »). "" si absente.
fn requete_cible(ligne: Text) -> Text {
    let parts = split(ligne, " ")
    if len(parts) < 2 {
        return ""
    }
    return get(parts, 1)
}

// Version d'une ligne de requête (« HTTP/1.1 »). "" si absente.
fn requete_version(ligne: Text) -> Text {
    let parts = split(ligne, " ")
    if len(parts) < 3 {
        return ""
    }
    return get(parts, 2)
}

// Chemin d'une cible (partie avant « ? »).
fn cible_chemin(cible: Text) -> Text {
    let q = unwrap_or(find(cible, "?"), -1)
    if q < 0 {
        return cible
    }
    return sub(cible, 0, q)
}

// Chaîne de requête d'une cible (partie après « ? », "" si absente).
fn cible_query(cible: Text) -> Text {
    let q = unwrap_or(find(cible, "?"), -1)
    if q < 0 {
        return ""
    }
    return sub(cible, q + 1, len(cible) - q - 1)
}

// Valeur d'un paramètre de requête : cible « /x?a=1&b=2 », clé « b » -> « 2 ».
fn query_param(cible: Text, cle: Text) -> Option<Text> {
    let qs = cible_query(cible)
    if len(qs) == 0 {
        return none
    }
    for paire in split(qs, "&") {
        let eq = unwrap_or(find(paire, "="), -1)
        if eq > 0 {
            let k = sub(paire, 0, eq)
            if k == cle {
                return some(sub(paire, eq + 1, len(paire) - eq - 1))
            }
        }
    }
    return none
}

// Valeur d'un en-tête « Clé: Valeur » si la clé correspond (insensible aux
// espaces autour de la valeur), sinon `none`.
fn entete_valeur(ligne: Text, cle: Text) -> Option<Text> {
    let sep = unwrap_or(find(ligne, ":"), -1)
    if sep <= 0 {
        return none
    }
    let k = sub(ligne, 0, sep)
    if lower(k) != lower(cle) {
        return none
    }
    return some(trim(sub(ligne, sep + 1, len(ligne) - sep - 1)))
}

// ---- Requête complète (ligne + en-têtes + corps) ----

record RequeteHttp {
    methode: Text,
    cible: Text,
    chemin: Text,
    query: Text,
    version: Text,
    corps: Text
}

// Corps de la requête : ce qui suit la première ligne vide « \r\n\r\n ».
fn corps_requete(brut: Text) -> Text {
    let sep = unwrap_or(find(brut, "\r\n\r\n"), -1)
    if sep < 0 {
        return ""
    }
    return sub(brut, sep + 4, len(brut) - sep - 4)
}

// Première ligne (ligne de requête) d'une requête brute.
fn ligne_requete(brut: Text) -> Text {
    let i = unwrap_or(find(brut, "\r\n"), -1)
    if i < 0 {
        return brut
    }
    return sub(brut, 0, i)
}

// Analyse une requête HTTP brute complète.
fn parse_requete(brut: Text) -> RequeteHttp {
    let ligne = ligne_requete(brut)
    let cible = requete_cible(ligne)
    return RequeteHttp {
        methode: requete_methode(ligne),
        cible: cible,
        chemin: cible_chemin(cible),
        query: cible_query(cible),
        version: requete_version(ligne),
        corps: corps_requete(brut)
    }
}

// Valeur d'un en-tête parmi TOUTES les lignes d'en-tête (insensible à la casse).
fn entete_de(brut: Text, cle: Text) -> Option<Text> {
    for ligne in split(brut, "\r\n") {
        if len(ligne) == 0 {
            return none
        }
        let v = entete_valeur(ligne, cle)
        if has(v) {
            return v
        }
    }
    return none
}

// La requête dépasse-t-elle la taille maximale autorisée (limite anti-abus) ?
fn depasse_taille(brut: Text, max_octets: Int) -> Bool {
    return len(brut) > max_octets
}

// ---- Construction de réponses ----

// Réponse HTTP complète : ligne de statut + en-têtes usuels + corps.
fn reponse(code: Int, content_type: Text, corps: Text) -> Text {
    return "HTTP/1.1 " + text(code) + " " + statut_texte(code)
        + "\r\nServer: nol-http"
        + "\r\nContent-Type: " + content_type
        + "\r\nContent-Length: " + text(len(corps))
        + "\r\nConnection: close\r\n\r\n" + corps
}

fn reponse_texte(code: Int, corps: Text) -> Text {
    return reponse(code, "text/plain; charset=utf-8", corps)
}
fn reponse_html(code: Int, corps: Text) -> Text {
    return reponse(code, "text/html; charset=utf-8", corps)
}
fn reponse_json(code: Int, corps: Text) -> Text {
    return reponse(code, "application/json", corps)
}

// ---- Streaming (Transfer-Encoding: chunked) ----

fn hex(n: Int) -> Text {
    if n == 0 {
        return "0"
    }
    let chiffres = "0123456789abcdef"
    var v = n
    var out = ""
    while v > 0 {
        out = char_at(chiffres, v % 16) + out
        v = v / 16
    }
    return out
}

// En-têtes d'une réponse en flux (chunked). Le corps suit, morceau par morceau.
fn entetes_flux(code: Int, content_type: Text) -> Text {
    return "HTTP/1.1 " + text(code) + " " + statut_texte(code)
        + "\r\nServer: nol-http"
        + "\r\nContent-Type: " + content_type
        + "\r\nTransfer-Encoding: chunked\r\n\r\n"
}

// Un morceau chunké : taille en hexa, CRLF, données, CRLF.
fn chunk(donnees: Text) -> Text {
    return hex(len(donnees)) + "\r\n" + donnees + "\r\n"
}

// Marqueur de fin de flux chunké.
fn chunk_fin() -> Text {
    return "0\r\n\r\n"
}

// ============================ TESTS ============================

fn test_methode() {
    assert(methode_valide("GET"), "GET valide")
    assert(methode_valide("DELETE"), "DELETE valide")
    assert(not methode_valide("BREW"), "BREW invalide")
}

fn test_normalise() {
    assert(chemin_normalise("/a/b/") == "/a/b", "retire barre finale")
    assert(chemin_normalise("/") == "/", "racine conservee")
    assert(chemin_normalise("/a") == "/a", "sans barre inchange")
}

fn test_correspond() {
    assert(chemin_correspond("/users", "/users/"), "egaux aux barres pres")
    assert(not chemin_correspond("/users", "/posts"), "differents")
}

fn test_statut() {
    assert(statut_texte(200) == "OK", "200")
    assert(statut_texte(404) == "Not Found", "404")
}

fn test_ligne_requete() {
    let l = "GET /users?tri=nom HTTP/1.1"
    assert(requete_methode(l) == "GET", "methode")
    assert(requete_cible(l) == "/users?tri=nom", "cible")
    assert(requete_version(l) == "HTTP/1.1", "version")
    assert(requete_methode("") == "", "vide")
}

fn test_cible() {
    assert(cible_chemin("/a/b?x=1") == "/a/b", "chemin")
    assert(cible_query("/a/b?x=1") == "x=1", "query")
    assert(cible_chemin("/a/b") == "/a/b", "sans query")
    assert(cible_query("/a/b") == "", "query vide")
}

fn test_query_param() {
    let c = "/x?a=1&b=deux&c=3"
    assert(unwrap_or(query_param(c, "b"), "NON") == "deux", "param b")
    assert(unwrap_or(query_param(c, "a"), "NON") == "1", "param a")
    assert(unwrap_or(query_param(c, "z"), "NON") == "NON", "param absent")
}

fn test_entete() {
    assert(unwrap_or(entete_valeur("Content-Type: text/html", "content-type"), "NON") == "text/html", "entete insensible casse")
    assert(unwrap_or(entete_valeur("Host: example.com", "Accept"), "NON") == "NON", "mauvaise cle")
}

fn requete_brute() -> Text {
    return "POST /api/users?tri=nom HTTP/1.1\r\nHost: exemple.com\r\nContent-Type: application/json\r\nContent-Length: 13\r\n\r\n{\"nom\":\"Bo\"}"
}

fn test_parse_requete() {
    let r = parse_requete(requete_brute())
    assert(r.methode == "POST", "methode")
    assert(r.chemin == "/api/users", "chemin")
    assert(r.query == "tri=nom", "query")
    assert(r.version == "HTTP/1.1", "version")
    assert(r.corps == "{\"nom\":\"Bo\"}", "corps")
}

fn test_entete_de() {
    assert(unwrap_or(entete_de(requete_brute(), "content-type"), "") == "application/json", "content-type")
    assert(unwrap_or(entete_de(requete_brute(), "Host"), "") == "exemple.com", "host")
    assert(not has(entete_de(requete_brute(), "Authorization")), "absent")
}

fn test_reponse() {
    let rep = reponse(404, "text/plain; charset=utf-8", "nope")
    assert(starts_with(rep, "HTTP/1.1 404 Not Found\r\n"), "ligne de statut")
    assert(contains(rep, "Content-Length: 4"), "content-length")
    assert(contains(rep, "\r\n\r\nnope"), "corps apres entetes")
    assert(contains(reponse_json(200, "{}"), "Content-Type: application/json"), "json")
    assert(contains(reponse_texte(200, "x"), "text/plain"), "texte")
    assert(contains(reponse_html(200, "<b/>"), "text/html"), "html")
}

fn test_limite() {
    assert(depasse_taille("aaaaa", 3), "depassement detecte")
    assert(not depasse_taille("ab", 10), "sous la limite")
}

fn test_chunked() {
    assert(hex(255) == "ff", "hex")
    assert(hex(0) == "0", "hex zero")
    assert(chunk("Wiki") == "4\r\nWiki\r\n", "chunk")
    assert(chunk_fin() == "0\r\n\r\n", "fin de flux")
    assert(contains(entetes_flux(200, "text/plain"), "Transfer-Encoding: chunked"), "entete chunked")
}

fn test_statuts_etendus() {
    assert(statut_texte(201) == "Created", "201")
    assert(statut_texte(400) == "Bad Request", "400")
    assert(statut_texte(429) == "Too Many Requests", "429")
    assert(statut_texte(503) == "Service Unavailable", "503")
}
